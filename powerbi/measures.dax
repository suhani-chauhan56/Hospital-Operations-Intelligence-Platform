// Core operational measures
Admissions = DISTINCTCOUNT(admissions[admission_id])
Patients = DISTINCTCOUNT(admissions[patient_id])
Readmission Rate = AVERAGE(admissions[readmitted_30d])
Average LOS = AVERAGE(admissions[los_days])
Average Wait = AVERAGE(admissions[waiting_time_minutes])

// Finance and claims
Paid Revenue = SUM(billing[paid_amount])
Billed Revenue = SUM(billing[billed_amount])
Revenue Leakage = SUM(billing[claim_gap])
Claim Approval Ratio = AVERAGE(claims[claim_approved])
Revenue Per Patient = DIVIDE([Paid Revenue], [Patients])

// Workload and capacity
Admissions Per Doctor = DIVIDE([Admissions], DISTINCTCOUNT(doctors[doctor_id]))
Weekend Admissions =
    CALCULATE([Admissions], WEEKDAY(admissions[admit_date], 2) >= 6)
Weekend Admission Rate = DIVIDE([Weekend Admissions], [Admissions])

// Time intelligence
Prior Month Revenue =
    CALCULATE([Paid Revenue], DATEADD('Calendar'[Date], -1, MONTH))
Monthly Revenue Growth =
    DIVIDE([Paid Revenue] - [Prior Month Revenue], [Prior Month Revenue])
Admissions 30D =
    CALCULATE([Admissions], DATESINPERIOD('Calendar'[Date], MAX('Calendar'[Date]), -30, DAY))

// Governed command-center analytical marts
Patients Today = MAX(command_center_kpis[patients_today])
Current Occupancy % = DIVIDE(MAX(command_center_kpis[occupancy_pct]), 100)
Occupied Beds = MAX(command_center_kpis[occupied_beds])
Emergency Wait = MAX(command_center_kpis[emergency_wait_minutes])
Critical Patients = MAX(command_center_kpis[critical_patients])
Doctor Utilization % =
    DIVIDE(MAX(command_center_kpis[doctor_utilization_pct]), 100)
Hospital Efficiency Score =
    MAX(command_center_kpis[hospital_efficiency_score])

Next Week Emergency Patients =
    MAX(operational_forecast_summary[emergency_patients])
Emergency Growth % =
    DIVIDE(MAX(operational_forecast_summary[emergency_growth_pct]), 100)
Additional Beds Required =
    MAX(operational_forecast_summary[additional_beds])
Peak Forecast Day =
    SELECTEDVALUE(operational_forecast_summary[peak_day])

Department Efficiency Score =
    CALCULATE(
        MAX(hospital_efficiency_scores[efficiency_score]),
        hospital_efficiency_scores[scope_type] = "department"
    )
